# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Base de datos de desarrollo (servicio `db` de compose.yaml).
# La de pruebas va en .env.test, puerto 54411.
#--------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync
